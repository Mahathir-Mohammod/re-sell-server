PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Better Auth runs in the Next.js client; the API only verifies its JWTs.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Optional. Set both in production to the same value as BETTER_AUTH_URL in the client.
BETTER_AUTH_ISSUER=
BETTER_AUTH_AUDIENCE=
# Image upload (imgbb.com -> Get API key). Without it POST /api/products/upload returns 503.
IMGBB_API_KEY=
